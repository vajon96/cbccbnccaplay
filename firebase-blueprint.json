{
  "entities": {
    "user_profile": {
      "title": "User Profile",
      "description": "Authenticated user account profile linked directly to Firebase Authentication UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "displayName": { "type": "string", "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 1500 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "moderator", "sub_admin", "exam_admin", "qr_admin", "attendance_officer", "cadet", "user"] },
        "applicantId": { "type": "string", "maxLength": 64 },
        "registrationNumber": { "type": "string", "maxLength": 64 },
        "provider": { "type": "string", "maxLength": 40 },
        "emailVerified": { "type": "boolean" },
        "accountStatus": { "type": "string", "enum": ["Active", "Suspended"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "accountStatus"]
    },
    "applicant": {
      "title": "Applicant",
      "description": "Represents a BNCC enrollment applicant bound to an authenticated ownerUid or public submission.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128, "description": "Firebase Auth UID of the applicant owner" },
        "fullNameBangla": { "type": "string", "maxLength": 160 },
        "fullNameEnglish": { "type": "string", "maxLength": 160 },
        "fatherNameBangla": { "type": "string", "maxLength": 160 },
        "fatherNameEnglish": { "type": "string", "maxLength": 160 },
        "motherNameBangla": { "type": "string", "maxLength": 160 },
        "motherNameEnglish": { "type": "string", "maxLength": 160 },
        "dob": { "type": "string", "maxLength": 32 },
        "nidBirthReg": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other", "Others"] },
        "religion": { "type": "string", "maxLength": 64 },
        "presentAddress": { "type": "string", "maxLength": 500 },
        "permanentAddress": { "type": "string", "maxLength": 500 },
        "studentPhone": { "type": "string", "maxLength": 32 },
        "studentEmail": { "type": "string", "maxLength": 160 },
        "heightFeet": { "type": "string", "maxLength": 8 },
        "heightInches": { "type": "string", "maxLength": 8 },
        "weightKg": { "type": "string", "maxLength": 16 },
        "bloodGroup": { "type": "string", "maxLength": 16 },
        "sscGpa": { "type": "string", "maxLength": 16 },
        "sscGroup": { "type": "string", "maxLength": 64 },
        "sscYear": { "type": "string", "maxLength": 16 },
        "sscBoard": { "type": "string", "maxLength": 64 },
        "hscGpa": { "type": "string", "maxLength": 16 },
        "hscGroup": { "type": "string", "maxLength": 64 },
        "hscYear": { "type": "string", "maxLength": 16 },
        "hscBoard": { "type": "string", "maxLength": 64 },
        "studyStatus": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "classRoll": { "type": "string", "maxLength": 40 },
        "section": { "type": "string", "maxLength": 40 },
        "session": { "type": "string", "maxLength": 40 },
        "emisId": { "type": "string", "maxLength": 64 },
        "collegeName": { "type": "string", "maxLength": 180 },
        "photo": { "type": "string", "maxLength": 500000 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "attendanceStatus": { "type": "string", "enum": ["Present", "Absent"] },
        "attendanceTime": { "type": "string", "format": "date-time" },
        "registrationNumber": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["cadet", "user"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullNameEnglish", "studentPhone", "status", "ownerUid"]
    },
    "admission": {
      "title": "Admission Record",
      "description": "Structured admission lifecycle record linked to an application and optional ownerUid.",
      "type": "object",
      "properties": {
        "applicantId": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "fullNameEnglish": { "type": "string", "maxLength": 160 },
        "fullNameBangla": { "type": "string", "maxLength": 160 },
        "session": { "type": "string", "maxLength": 40 },
        "studyStatus": { "type": "string", "maxLength": 100 },
        "admissionStatus": { "type": "string", "enum": ["Pending", "Under Review", "Approved", "Admitted", "Rejected"] },
        "decisionBy": { "type": "string", "maxLength": 128 },
        "remarks": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicantId", "ownerUid", "admissionStatus"]
    },
    "contact_message": {
      "title": "Contact Message",
      "description": "Public inquiry or support message delivered in real time to admin and moderator dashboards.",
      "type": "object",
      "properties": {
        "referenceId": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 160 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["unread", "read", "replied", "resolved"] },
        "adminNote": { "type": "string", "maxLength": 2000 },
        "handledBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "message", "status", "ownerUid"]
    },
    "system_setting": {
      "title": "System Setting",
      "description": "Portal-wide operational toggles and non-sensitive configuration.",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string", "maxLength": 200 },
        "enrollmentOpen": { "type": "boolean" },
        "examPortalOpen": { "type": "boolean" },
        "offlineFormOpen": { "type": "boolean" },
        "noticeTickerEnabled": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "contactEmail": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 500 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "admin": {
      "title": "Admin",
      "description": "Administrative or moderator user document keyed by Firebase Auth UID or officer record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string", "maxLength": 120 },
        "username": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "moderator", "sub_admin", "exam_admin", "qr_admin", "attendance_officer"] },
        "permissions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role"]
    },
    "qr_record": {
      "title": "Public QR Projection",
      "description": "Non-PII public verification projection for cadet QR card scanning.",
      "type": "object",
      "properties": {
        "cadetId": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "registrationNumber": { "type": "string", "maxLength": 64 },
        "fullNameEnglish": { "type": "string", "maxLength": 160 },
        "fullNameBangla": { "type": "string", "maxLength": 160 },
        "studyStatus": { "type": "string", "maxLength": 100 },
        "session": { "type": "string", "maxLength": 40 },
        "collegeName": { "type": "string", "maxLength": 180 },
        "platoonName": { "type": "string", "maxLength": 180 },
        "status": { "type": "string", "maxLength": 40 },
        "isValidCadet": { "type": "boolean" },
        "attendanceStatus": { "type": "string", "maxLength": 40 },
        "batch": { "type": "string", "maxLength": 40 },
        "photo": { "type": "string", "maxLength": 450000 }
      },
      "required": ["cadetId", "fullNameEnglish", "status"]
    },
    "exam": {
      "title": "Exam",
      "description": "Sanitized exam definition without answer keys.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["draft", "scheduled", "published", "live", "completed", "archived"] },
        "durationMinutes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "status"]
    },
    "exam_answer_key": {
      "title": "Exam Answer Key",
      "description": "Encrypted/sealed answer keys readable only by exam/super admins.",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "sealedPayload": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "sealedPayload"]
    },
    "exam_attempt": {
      "title": "Exam Attempt",
      "description": "Candidate exam attempt and live answers owned by ownerUid.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "examId": { "type": "string" },
        "candidateId": { "type": "string" },
        "status": { "type": "string", "enum": ["in_progress", "submitted", "auto_submitted", "expired", "graded"] },
        "answers": { "type": "object" },
        "startedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "examId", "candidateId", "status"]
    },
    "exam_result": {
      "title": "Exam Result",
      "description": "Scored exam result owned by ownerUid.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "attemptId": { "type": "string" },
        "examId": { "type": "string" },
        "obtainedMarks": { "type": "number" },
        "totalMarks": { "type": "number" },
        "gradingStatus": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerUid", "attemptId", "examId"]
    },
    "message": {
      "title": "Message",
      "description": "Private 1:1 thread or platoon announcement message.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "threadId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 4000 },
        "role": { "type": "string", "maxLength": 40 },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "content", "timestamp"]
    },
    "notification": {
      "title": "Notification",
      "description": "System and user notifications.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "maxLength": 40 },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "title", "message", "timestamp"]
    },
    "offline_application": {
      "title": "Offline Application",
      "description": "Offline printable/paper cadet application synced from client.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "applicationNumber": { "type": "string", "maxLength": 64 },
        "syncStatus": { "type": "string", "enum": ["Draft", "Pending Sync", "Syncing", "Synced", "Sync Failed", "Requires Review"] },
        "reviewStatus": { "type": "string", "enum": ["Pending", "Reviewed", "Approved", "Rejected"] }
      },
      "required": ["applicationNumber", "syncStatus"]
    },
    "cms_document": {
      "title": "CMS Document",
      "description": "Structured CMS item/section/profile/media document.",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "media_asset": {
      "title": "Media Asset",
      "description": "Centralized platform media library metadata record with strict public/private visibility isolation.",
      "type": "object",
      "properties": {
        "fileName": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "altText": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "sizeBytes": { "type": "integer" },
        "category": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array" },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "storageLocation": { "type": "string", "enum": ["firebase_storage", "server_vault", "public_assets", "external"] },
        "storagePath": { "type": "string", "maxLength": 500 },
        "url": { "type": "string", "maxLength": 1500 },
        "uploadedBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fileName", "mimeType", "visibility", "url"]
    },
    "generic_admin_record": {
      "title": "Admin Managed Record",
      "description": "Protected operational or audit document managed by admins.",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "user_profile", "description": "Firebase Auth UID-linked user profiles and RBAC roles" },
    "/circulars/{circularId}": { "schema": "generic_admin_record", "description": "Recruitment circulars" },
    "/circulars/{circularId}/chunks/{chunkId}": { "schema": "generic_admin_record", "description": "Circular PDF chunks" },
    "/circular_settings/{settingId}": { "schema": "generic_admin_record", "description": "Circular settings" },
    "/guides/{guideId}": { "schema": "generic_admin_record", "description": "Admission guides" },
    "/guide_settings/{settingId}": { "schema": "generic_admin_record", "description": "Guide settings" },
    "/applicants/{applicantId}": { "schema": "applicant", "description": "BNCC applicants & cadets (PII isolated)" },
    "/applications/{applicationId}": { "schema": "applicant", "description": "Normalized online applications dossier" },
    "/admissions/{admissionId}": { "schema": "admission", "description": "Admission review and enrollment decisions" },
    "/contact_messages/{messageId}": { "schema": "contact_message", "description": "Public inquiry messages delivered to admins/moderators" },
    "/system_settings/{settingId}": { "schema": "system_setting", "description": "Global portal operational toggles and settings" },
    "/pending_profile_changes/{changeId}": { "schema": "generic_admin_record", "description": "Cadet profile change requests" },
    "/counters/{counterId}": { "schema": "generic_admin_record", "description": "Sequential registration ID counter" },
    "/attendance_logs/{logId}": { "schema": "generic_admin_record", "description": "Attendance audit events" },
    "/notifications/{notifId}": { "schema": "notification", "description": "Notifications for cadets and platoon" },
    "/admin_config/{configId}": { "schema": "generic_admin_record", "description": "Admin config" },
    "/activity_logs/{logId}": { "schema": "generic_admin_record", "description": "Activity audit logs" },
    "/security_logs/{logId}": { "schema": "generic_admin_record", "description": "Security audit logs" },
    "/password_resets/{resetId}": { "schema": "generic_admin_record", "description": "Authorized password reset requests" },
    "/messages/{messageId}": { "schema": "message", "description": "Scoped messenger threads & announcements" },
    "/admins/{adminId}": { "schema": "admin", "description": "Verified platform admins and moderators" },
    "/adminTokens/{tokenId}": { "schema": "generic_admin_record", "description": "QR officer login tokens" },
    "/public_qr_cards/{cardId}": { "schema": "qr_record", "description": "Non-PII single-document public QR verification cards" },
    "/qr_records/{qrRecordId}": { "schema": "generic_admin_record", "description": "Admin-only QR inspection logs" },
    "/question_bank/{questionId}": { "schema": "generic_admin_record", "description": "Admin-only question bank" },
    "/exams/{examId}": { "schema": "exam", "description": "Published exam shells (keys stripped)" },
    "/exam_answer_keys/{keyId}": { "schema": "exam_answer_key", "description": "Admin-only answer keys" },
    "/exam_attempts/{attemptId}": { "schema": "exam_attempt", "description": "Candidate exam attempts" },
    "/exam_results/{resultId}": { "schema": "exam_result", "description": "Exam results" },
    "/exam_settings/{settingId}": { "schema": "generic_admin_record", "description": "Exam module settings" },
    "/exam_activity_logs/{logId}": { "schema": "generic_admin_record", "description": "Exam audit logs" },
    "/answer_script_audit_logs/{logId}": { "schema": "generic_admin_record", "description": "Grading script audit logs" },
    "/leaderboard/{entryId}": { "schema": "generic_admin_record", "description": "Exam leaderboard rankings" },
    "/cms_content/{id}": { "schema": "cms_document", "description": "Universal editable CMS strings" },
    "/cms_sections/{id}": { "schema": "cms_document", "description": "Page section visibility and ordering" },
    "/cms_cadets/{id}": { "schema": "cms_document", "description": "Public cadet directory showcase" },
    "/cms_incharges/{id}": { "schema": "cms_document", "description": "Public in-charges showcase" },
    "/cms_commander/{id}": { "schema": "cms_document", "description": "Platoon commander public profile" },
    "/cms_notices/{id}": { "schema": "cms_document", "description": "Public CMS notices" },
    "/cms_activities/{id}": { "schema": "cms_document", "description": "Public CMS activities" },
    "/cms_gallery/{id}": { "schema": "cms_document", "description": "Public CMS media gallery" },
    "/cms_settings/{id}": { "schema": "cms_document", "description": "Global CMS site settings" },
    "/cms_pages/{id}": { "schema": "cms_document", "description": "Custom dynamic CMS pages" },
    "/offline_applications/{id}": { "schema": "offline_application", "description": "Local-first synced offline applications" },
    "/media_assets/{assetId}": { "schema": "media_asset", "description": "Centralized Media Management Library metadata" },
    "/test/{id}": { "schema": "generic_admin_record", "description": "Firestore connectivity check document" }
  }
}
