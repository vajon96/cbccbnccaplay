rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Identity & Validation Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.:\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAuthenticatedUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasAdminDoc() {
      return isAuthenticatedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDocData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isAuthenticatedUser() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return (isVerifiedEmail() && request.auth.token.email == 'sajondey102@gmail.com')
        || (hasAdminDoc() && ('role' in adminDocData()) && adminDocData().role == 'super_admin');
    }

    function isAdmin() {
      return isSuperAdmin()
        || (hasAdminDoc() && (!('role' in adminDocData()) || adminDocData().role in ['super_admin', 'admin', 'exam_admin', 'qr_admin', 'attendance_officer']))
        || (hasUserDoc() && userDocData().role in ['super_admin', 'admin']);
    }

    function isModerator() {
      return isAdmin()
        || (hasAdminDoc() && adminDocData().role in ['moderator', 'sub_admin'])
        || (hasUserDoc() && userDocData().role in ['moderator', 'sub_admin']);
    }

    function isOwner(data) {
      return isAuthenticatedUser() && ('ownerUid' in data) && data.ownerUid == request.auth.uid;
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['uid', 'role', 'accountStatus'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.role in ['super_admin', 'admin', 'moderator', 'sub_admin', 'exam_admin', 'qr_admin', 'attendance_officer', 'cadet', 'user']
        && data.accountStatus in ['Active', 'Suspended']
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 160));
    }

    function isValidApplicantCreate(data) {
      return data.keys().hasAll(['fullNameEnglish', 'studentPhone', 'status', 'ownerUid'])
        && data.fullNameEnglish is string && data.fullNameEnglish.size() > 0 && data.fullNameEnglish.size() <= 200
        && data.studentPhone is string && data.studentPhone.size() >= 6 && data.studentPhone.size() <= 32
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.status in ['Pending', 'Approved', 'Rejected']
        && (!('role' in data) || data.role in ['cadet', 'user'])
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 500000));
    }

    function isValidApplicantUpdate(data) {
      return data.fullNameEnglish is string && data.fullNameEnglish.size() > 0 && data.fullNameEnglish.size() <= 200
        && data.studentPhone is string && data.studentPhone.size() >= 6 && data.studentPhone.size() <= 32
        && (!('status' in data) || data.status in ['Pending', 'Approved', 'Rejected'])
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 500000));
    }

    function isValidAdmission(data) {
      return data.keys().hasAll(['applicantId', 'ownerUid', 'admissionStatus'])
        && data.applicantId is string && data.applicantId.size() > 0 && data.applicantId.size() <= 64
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.admissionStatus in ['Pending', 'Under Review', 'Approved', 'Admitted', 'Rejected'];
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'phone', 'message', 'status', 'ownerUid'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.status in ['unread', 'read', 'replied', 'resolved']
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 200));
    }

    function isValidOfflineApp(data) {
      return data.keys().hasAll(['applicationNumber', 'syncStatus'])
        && data.applicationNumber is string && data.applicationNumber.size() > 0 && data.applicationNumber.size() <= 80
        && data.syncStatus is string && data.syncStatus.size() <= 40;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'content', 'timestamp'])
        && data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 160
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000;
    }

    function isValidExamAttempt(data) {
      return data.keys().hasAll(['ownerUid', 'examId', 'candidateId', 'status'])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.examId is string && data.examId.size() > 0 && data.examId.size() <= 128
        && data.candidateId is string && data.candidateId.size() > 0 && data.candidateId.size() <= 128
        && data.status in ['in_progress', 'submitted', 'auto_submitted', 'expired', 'graded'];
    }

    function isValidExamResult(data) {
      return data.keys().hasAll(['ownerUid', 'attemptId', 'examId'])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.attemptId is string && data.attemptId.size() > 0 && data.attemptId.size() <= 128
        && data.examId is string && data.examId.size() > 0 && data.examId.size() <= 128;
    }

    // 0. Firebase Auth UID-Linked User Profiles & RBAC Directory
    match /users/{uid} {
      allow get: if isValidId(uid) && (isModerator() || (isAuthenticatedUser() && uid == request.auth.uid));
      allow list: if isModerator();
      allow create: if isValidId(uid) && isValidUserCreate(incoming()) && (
        isSuperAdmin() ||
        (isAuthenticatedUser()
          && uid == request.auth.uid
          && incoming().uid == request.auth.uid
          && incoming().role == 'user'
          && incoming().accountStatus == 'Active')
      );
      allow update: if isValidId(uid) && (
        isSuperAdmin() ||
        (isAdmin()
          && (!('role' in incoming()) || incoming().role != 'super_admin')
          && (!('role' in existing()) || existing().role != 'super_admin')) ||
        (isAuthenticatedUser()
          && uid == request.auth.uid
          && incoming().uid == existing().uid
          && incoming().role == existing().role
          && incoming().accountStatus == existing().accountStatus
          && (!('isActive' in existing()) || incoming().isActive == existing().isActive)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'phone', 'email', 'emailVerified', 'provider',
            'applicantId', 'registrationNumber', 'lastLoginAt', 'updatedAt'
          ]))
      );
      allow delete: if isValidId(uid) && isSuperAdmin();
    }

    // 1. Public Institutional Website, System Settings & CMS Collections
    match /system_settings/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 50;
      allow delete: if isValidId(id) && isSuperAdmin();
    }

    match /cms_content/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_sections/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_cadets/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 35;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_incharges/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_commander/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_notices/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_activities/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_gallery/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_settings/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 50;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /cms_pages/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update: if isValidId(id) && isAdmin() && incoming().size() <= 30;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /circular_settings/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /circulars/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update, delete: if isValidId(id) && isAdmin();

      match /chunks/{chunkId} {
        allow get: if isValidId(id) && isValidId(chunkId);
        allow list: if true;
        allow create, update, delete: if isValidId(id) && isValidId(chunkId) && isAdmin();
      }
    }

    match /guide_settings/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /guides/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    // 2. Non-PII Public QR Projection (Zero phones/emails/NIDs/passwords, no public list enumeration)
    match /public_qr_cards/{id} {
      allow get: if isValidId(id);
      allow list: if isAdmin();
      allow create: if isValidId(id)
        && !('password' in incoming())
        && !('passwordHash' in incoming())
        && !('nidBirthReg' in incoming())
        && !('studentPhone' in incoming())
        && !('studentEmail' in incoming())
        && !('presentAddress' in incoming())
        && !('permanentAddress' in incoming())
        && (
          isModerator() ||
          (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid) ||
          (incoming().ownerUid == 'public_applicant' && incoming().status == 'Pending' && incoming().isValidCadet == false)
        );
      allow update: if isValidId(id)
        && (
          isModerator() ||
          (isAuthenticatedUser() && isOwner(existing()) && incoming().ownerUid == existing().ownerUid) ||
          (isAuthenticatedUser()
            && isVerifiedEmail()
            && existing().ownerUid == 'public_applicant'
            && exists(/databases/$(database)/documents/applicants/$(id))
            && get(/databases/$(database)/documents/applicants/$(id)).data.ownerUid == request.auth.uid
            && incoming().ownerUid == request.auth.uid
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'updatedAt']))
        )
        && !('password' in incoming())
        && !('passwordHash' in incoming())
        && !('nidBirthReg' in incoming())
        && !('studentPhone' in incoming())
        && !('studentEmail' in incoming())
        && !('presentAddress' in incoming())
        && !('permanentAddress' in incoming());
      allow delete: if isValidId(id) && isAdmin();
    }

    // QR Admin Inspection Records (Admin-Only)
    match /qr_records/{id} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    // 3. PII-Isolated Applicants, Applications, Admissions & Profile Changes
    match /applicants/{id} {
      allow get: if isValidId(id) && (isModerator() || isOwner(existing()));
      allow list: if isModerator() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id)
        && isValidApplicantCreate(incoming())
        && (
          isAdmin() ||
          (
            incoming().status == 'Pending' &&
            (!('role' in incoming()) || incoming().role == 'user') &&
            (
              (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid) ||
              incoming().ownerUid == 'public_applicant'
            )
          )
        );
      allow update: if isValidId(id)
        && (
          isAdmin() ||
          (isModerator()
            && incoming().ownerUid == existing().ownerUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'isActive', 'accountStatus', 'attendanceStatus', 'attendanceTime', 'updatedAt'
            ])) ||
          (
            isValidApplicantUpdate(incoming()) &&
            isAuthenticatedUser() &&
            isOwner(existing()) &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'presentAddress', 'permanentAddress', 'studentEmail', 'bloodGroup',
              'weightKg', 'heightFeet', 'heightInches', 'photo',
              'emergencyContactName', 'emergencyContactPhone',
              'hasPendingEdits', 'pendingEditsId', 'updatedAt', 'passwordHash'
            ])
          ) ||
          (
            isAuthenticatedUser() &&
            isVerifiedEmail() &&
            existing().ownerUid == 'public_applicant' &&
            ('studentEmail' in existing()) &&
            existing().studentEmail is string &&
            existing().studentEmail.lower() == request.auth.token.email.lower() &&
            incoming().ownerUid == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(id) && isAdmin();
    }

    match /applications/{id} {
      allow get: if isValidId(id) && (isModerator() || isOwner(existing()));
      allow list: if isModerator() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id)
        && isValidApplicantCreate(incoming())
        && (
          isAdmin() ||
          (
            incoming().status == 'Pending' &&
            (!('role' in incoming()) || incoming().role == 'user') &&
            (
              (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid) ||
              incoming().ownerUid == 'public_applicant'
            )
          )
        );
      allow update: if isValidId(id) && isModerator();
      allow delete: if isValidId(id) && isAdmin();
    }

    match /admissions/{id} {
      allow get: if isValidId(id) && (isModerator() || isOwner(existing()));
      allow list: if isModerator() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id) && isValidAdmission(incoming()) && (
        isAdmin() ||
        (
          incoming().admissionStatus == 'Pending' &&
          (
            (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid) ||
            incoming().ownerUid == 'public_applicant'
          )
        )
      );
      allow update: if isValidId(id) && (
        (isModerator() && incoming().admissionStatus in ['Pending', 'Under Review', 'Approved', 'Admitted', 'Rejected']) ||
        (isAuthenticatedUser()
          && isVerifiedEmail()
          && existing().ownerUid == 'public_applicant'
          && exists(/databases/$(database)/documents/applicants/$(id))
          && get(/databases/$(database)/documents/applicants/$(id)).data.ownerUid == request.auth.uid
          && incoming().ownerUid == request.auth.uid
          && incoming().admissionStatus == existing().admissionStatus
          && incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'updatedAt']))
      );
      allow delete: if isValidId(id) && isAdmin();
    }

    match /pending_profile_changes/{id} {
      allow get: if isValidId(id) && (isModerator() || isOwner(existing()));
      allow list: if isModerator() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id)
        && isAuthenticatedUser()
        && incoming().ownerUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().size() <= 20;
      allow update: if isValidId(id) && isModerator();
      allow delete: if isValidId(id) && isAdmin();
    }

    // 4. Contact Messages (Public write-only or owner-read, real-time staff triage)
    match /contact_messages/{id} {
      allow get: if isValidId(id) && (isModerator() || isOwner(existing()));
      allow list: if isModerator() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id)
        && isValidContactMessage(incoming())
        && incoming().status == 'unread'
        && (
          isAdmin() ||
          (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid) ||
          incoming().ownerUid == 'public_visitor'
        );
      allow update: if isValidId(id)
        && isModerator()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'handledBy', 'updatedAt'])
        && incoming().status in ['unread', 'read', 'replied', 'resolved'];
      allow delete: if isValidId(id) && isAdmin();
    }

    // 5. Admins, Tokens & Operational Config
    match /admins/{id} {
      allow get: if isValidId(id) && (isModerator() || (isAuthenticatedUser() && id == request.auth.uid));
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(id) && isSuperAdmin();
    }

    match /adminTokens/{id} {
      allow get: if isValidId(id) && isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /admin_config/{id} {
      allow get: if isValidId(id) && isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    // 6. Counters (Monotonic +1 increment during applicant submission or Admin management)
    match /counters/{id} {
      allow get: if isValidId(id) && (isAdmin() || id == 'applicant_id' || isAuthenticatedUser());
      allow list: if isAdmin();
      allow create: if isValidId(id) && (isAdmin() || (id == 'applicant_id' && incoming().currentId == 1111));
      allow update: if isValidId(id) && (
        isAdmin() ||
        (id == 'applicant_id'
          && incoming().currentId is int
          && existing().currentId is int
          && incoming().currentId == existing().currentId + 1)
      );
      allow delete: if isValidId(id) && isSuperAdmin();
    }

    // 7. Audit, Attendance & Password Reset Requests
    match /activity_logs/{id} {
      allow get: if isValidId(id) && (isModerator() || isOwner(existing()));
      allow list: if isModerator() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id) && (
        isModerator() ||
        (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid && incoming().size() <= 14)
      );
      allow update, delete: if isValidId(id) && isSuperAdmin();
    }

    match /security_logs/{id} {
      allow get: if isValidId(id) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(id) && (isAdmin() || (isAuthenticatedUser() && incoming().size() <= 12));
      allow update, delete: if isValidId(id) && isSuperAdmin();
    }

    match /attendance_logs/{id} {
      allow get: if isValidId(id) && isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /password_resets/{id} {
      allow get: if isValidId(id) && (isAdmin() || isOwner(existing()));
      allow list: if isAdmin() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id) && isAuthenticatedUser() && incoming().ownerUid == request.auth.uid && incoming().status in ['pending', 'Pending'];
      allow update, delete: if isValidId(id) && isAdmin();
    }

    // 8. Scoped Messenger & Notifications
    match /messages/{id} {
      allow get: if isValidId(id) && (
        isModerator() ||
        existing().recipientId == 'ALL' ||
        isOwner(existing()) ||
        (isAuthenticatedUser() && (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid))
      );
      allow list: if isModerator() || (
        isAuthenticatedUser() && (
          resource.data.recipientId == 'ALL' ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        )
      );
      allow create: if isValidId(id) && isValidMessage(incoming()) && (
        isModerator() ||
        (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid && incoming().role != 'admin')
      );
      allow update: if isValidId(id) && (
        isModerator() ||
        (isAuthenticatedUser() && (isOwner(existing()) || existing().recipientId == request.auth.uid)
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt']))
      );
      allow delete: if isValidId(id) && (isAdmin() || isOwner(existing()));
    }

    match /notifications/{id} {
      allow get: if isValidId(id) && (
        isModerator() ||
        existing().targetId == 'ALL' ||
        isOwner(existing())
      );
      allow list: if isModerator() || (
        isAuthenticatedUser() && (resource.data.targetId == 'ALL' || resource.data.ownerUid == request.auth.uid)
      );
      allow create: if isValidId(id) && isModerator();
      allow update: if isValidId(id) && (
        isModerator() ||
        (isOwner(existing()) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt']))
      );
      allow delete: if isValidId(id) && isAdmin();
    }

    // 9. Examination Subsystem (Answer Keys Strictly Isolated to Admins)
    match /question_bank/{id} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /exam_answer_keys/{id} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /exams/{id} {
      allow get: if isValidId(id) && (isAdmin() || (isAuthenticatedUser() && existing().status in ['published', 'live']));
      allow list: if isAdmin() || (isAuthenticatedUser() && resource.data.status in ['published', 'live']);
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /exam_attempts/{id} {
      allow get: if isValidId(id) && (isAdmin() || isOwner(existing()));
      allow list: if isAdmin() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id) && isValidExamAttempt(incoming()) && (
        isAdmin() || (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid && incoming().status == 'in_progress')
      );
      allow update: if isValidId(id) && isValidExamAttempt(incoming()) && (
        isAdmin() ||
        (isAuthenticatedUser() && isOwner(existing()) && existing().status == 'in_progress'
          && incoming().ownerUid == existing().ownerUid
          && incoming().status in ['in_progress', 'submitted', 'auto_submitted', 'expired'])
      );
      allow delete: if isValidId(id) && isAdmin();
    }

    match /exam_results/{id} {
      allow get: if isValidId(id) && (isAdmin() || isOwner(existing()));
      allow list: if isAdmin() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id) && isValidExamResult(incoming()) && (
        isAdmin() || (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid)
      );
      allow update, delete: if isValidId(id) && isAdmin();
    }

    match /exam_settings/{id} {
      allow get: if isValidId(id) && (isAdmin() || isAuthenticatedUser());
      allow list: if isAdmin() || isAuthenticatedUser();
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /exam_activity_logs/{id} {
      allow get, list: if isAdmin();
      allow create: if isValidId(id) && (isAdmin() || isAuthenticatedUser());
      allow update, delete: if isValidId(id) && isSuperAdmin();
    }

    match /answer_script_audit_logs/{id} {
      allow get: if isValidId(id) && (isAdmin() || isOwner(existing()));
      allow list: if isAdmin() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /leaderboard/{id} {
      allow get: if isValidId(id) && (isAdmin() || isAuthenticatedUser());
      allow list: if isAdmin() || isAuthenticatedUser();
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    // 10. Local-First Synced Offline Applications
    match /offline_applications/{id} {
      allow get: if isValidId(id) && (isModerator() || isOwner(existing()));
      allow list: if isModerator() || (isAuthenticatedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(id) && isValidOfflineApp(incoming()) && (
        isAdmin() || (isAuthenticatedUser() && incoming().ownerUid == request.auth.uid)
      );
      allow update: if isValidId(id) && isValidOfflineApp(incoming()) && (
        isModerator() ||
        (isAuthenticatedUser() && isOwner(existing()) && incoming().ownerUid == existing().ownerUid)
      );
      allow delete: if isValidId(id) && isAdmin();
    }

    // 11. Centralized Media Management Metadata (Public visibility vs Admin-only private isolation)
    match /media_assets/{id} {
      allow get: if isValidId(id) && (isAdmin() || existing().visibility == 'public');
      allow list: if isAdmin() || resource.data.visibility == 'public';
      allow create, update: if isValidId(id)
        && isAdmin()
        && incoming().size() <= 30
        && incoming().visibility in ['public', 'private'];
      allow delete: if isValidId(id) && isAdmin();
    }

    // 12. Health Check Document
    match /test/{id} {
      allow get: if isValidId(id);
      allow list: if false;
      allow write: if false;
    }
  }
}
