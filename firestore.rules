rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isNonEmptyString(val) {
      return val is string && val.size() > 0;
    }

    function isPositiveNumber(val) {
      return val is number && val >= 0;
    }

    // Circular Settings & Circulars
    match /circular_settings/{id} {
      allow read, write: if true;
    }

    match /circulars/{id} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Applicants & Profile Changes
    match /applicants/{id} {
      allow read, write: if true;
    }

    match /pending_profile_changes/{id} {
      allow read, write: if true;
    }

    // Admins & Admin Tokens
    match /admins/{id} {
      allow read, write: if true;
    }

    match /adminTokens/{id} {
      allow read, write: if true;
    }

    match /admin_config/{id} {
      allow read, write: if true;
    }

    // Activity & System Logs
    match /activity_logs/{id} {
      allow read, write: if true;
    }

    match /security_logs/{id} {
      allow read, write: if true;
    }

    match /messages/{id} {
      allow read, write: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    match /password_resets/{id} {
      allow read, write: if true;
    }

    match /counters/{id} {
      allow read, write: if true;
    }

    match /attendance_logs/{id} {
      allow read, write: if true;
    }

    match /qr_records/{id} {
      allow read, write: if true;
    }

    match /guides/{id} {
      allow read, write: if true;
    }

    match /guide_settings/{id} {
      allow read, write: if true;
    }

    match /test/{id} {
      allow read, write: if true;
    }

    // Examination Module Security Rules
    match /question_bank/{id} {
      allow read, write: if true;
    }

    match /exams/{id} {
      allow read, write: if true;
    }

    match /exam_attempts/{id} {
      allow read, write: if true;
    }

    match /exam_results/{id} {
      allow read, write: if true;
    }

    match /exam_settings/{id} {
      allow read, write: if true;
    }

    match /exam_activity_logs/{id} {
      allow read, write: if true;
    }
  }
}
