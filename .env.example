# ==============================================================================
# FRONTEND BUILD-TIME VARIABLES (Vite injects VITE_* into client bundle)
# NEVER put private secrets, passwords, or Gemini keys in VITE_* variables!
# ==============================================================================

# Public base URL of the Express backend when hosting static frontend separately
# (e.g. GitHub Pages / Netlify / Vercel / Cloudflare Pages -> Render/Railway/Cloud Run)
# Leave empty when frontend and backend are served from the same origin.
VITE_API_BASE_URL=

# Base public path for subpath hosting such as GitHub Pages: /<repo-name>/
# Leave empty or "/" for root domains (Netlify, Vercel, Cloudflare Pages, Cloud Run).
VITE_BASE_PATH=/

# Primary Super Admin email (non-secret identifier)
VITE_ADMIN_EMAIL=sajondey102@gmail.com

# Optional Firebase Web SDK overrides (defaults come from firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_DATABASE_ID=

# ==============================================================================
# BACKEND SERVER VARIABLES (Node.js / Express — Server-Side Only)
# ==============================================================================

PORT=3000
NODE_ENV=development

# Comma-separated frontend origins allowed to call /api/* with credentials
# Example: https://username.github.io,https://cbcc-bncc.netlify.app,https://*.pages.dev
ALLOWED_ORIGINS=

# Persistent disk directories for backend JSON stores and uploaded media vault
# Mount a persistent volume here on Render/Railway/Fly.io/VPS (defaults to ./.bncc-data and ./.bncc-media)
DATA_DIR=
MEDIA_DIR=

# Firebase project ID used by backend JWT verification (defaults to gen-lang-client-0584243831)
FIREBASE_PROJECT_ID=gen-lang-client-0584243831

# Authentication & Cryptographic Secrets (set strong random values in production)
ADMIN_LOGIN_PASSWORD=
SESSION_SECRET=
EXAM_KEY_SECRET=

# Server-Side Gemini AI API Key
GEMINI_API_KEY=
